ANTHROPIC_API_KEY=your_anthropic_api_key_here
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/debatemebro
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=your_jwt_secret_key_here
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=debatemebro

# Debate Mode: "demo" uses mock data, "live" calls real Claude API
DEBATE_MODE=demo

# Usage cap: max new debates per user (cached replays are free)
MAX_DEBATES_PER_USER=5

# Admin emails (comma-separated) — exempt from usage cap
ADMIN_EMAILS=
